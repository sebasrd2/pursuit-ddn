# Copy to .env and fill in as needed. See planning/pursuit-spec.md §13.

PURSUIT_LLM_PROVIDER=openrouter
PURSUIT_LLM_MODEL=
PURSUIT_LLM_API_KEY=
PURSUIT_LLM_DELAY_MS=1500
PURSUIT_LLM_MAX_RETRIES=5

PURSUIT_EMBED_PROVIDER=local
PURSUIT_EMBED_MODEL=
PURSUIT_RETRIEVAL_TOP_K=8

PURSUIT_WEB_LOOKUP=on
PURSUIT_WEB_ALLOWED_DOMAINS=ddn.com

PURSUIT_DATABASE_URL=
PURSUIT_FILE_STORE_PATH=./data
PURSUIT_KNOWLEDGE_PATH=./knowledge

PURSUIT_BIND=127.0.0.1
PURSUIT_PORT=8080
