    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "html-to-text": "^9.0.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "unpdf": "^1.4.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/multer": "^2.0.1",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
